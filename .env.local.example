# Supabase project settings — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL used to build email-redirect / OAuth callback links.
# Set to your deployed origin in production (e.g. https://js-arabic.dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: privacy-friendly analytics (Plausible). Leave unset to disable
# analytics entirely — nothing loads and no request is made either way.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=js-arabic.dev

# Optional: Cloudflare Turnstile site key for the CAPTCHA on register/login.
# Leave unset to disable CAPTCHA (the widget won't render).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
